rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Cases collection
    match /cases/{caseId} {
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      // Subcollections under cases (documents, evidence, conflicts, analysis_jobs, questions, timeline)
      match /documents/{documentId} {
        allow read, write: if isAuthenticated() && get(/databases/$(database)/documents/cases/$(caseId)).data.userId == request.auth.uid;
      }
      match /evidence/{evidenceId} {
        allow read, write: if isAuthenticated() && get(/databases/$(database)/documents/cases/$(caseId)).data.userId == request.auth.uid;
      }
      match /conflicts/{conflictId} {
        allow read, write: if isAuthenticated() && get(/databases/$(database)/documents/cases/$(caseId)).data.userId == request.auth.uid;
      }
      match /analysis_jobs/{jobId} {
        allow read, write: if isAuthenticated() && get(/databases/$(database)/documents/cases/$(caseId)).data.userId == request.auth.uid;
      }
      match /questions/{questionId} {
        allow read, write: if isAuthenticated() && get(/databases/$(database)/documents/cases/$(caseId)).data.userId == request.auth.uid;
      }
      match /timeline/{timelineId} {
        allow read, write: if isAuthenticated() && get(/databases/$(database)/documents/cases/$(caseId)).data.userId == request.auth.uid;
      }
    }
    
    // Standalone collections that might be queried directly but refer to caseId
    // In our backend we put documents in `cases/{caseId}/documents` but sometimes flat collections are easier.
    // Assuming we use flat collections with userId or caseId fields:
    match /briefs/{briefId} {
      allow read, write: if isAuthenticated() && request.resource.data.userId == request.auth.uid || resource.data.userId == request.auth.uid;
    }
  }
}
